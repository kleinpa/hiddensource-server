module(name = "hiddensource_server")

bazel_dep(name = "aspect_bazel_lib", version = "2.21.1")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_distroless", version = "0.8.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_python", version = "2.3.1")
bazel_dep(name = "rules_sourcemod", version = "1.0.0")
bazel_dep(name = "rules_steam")
git_override(
    module_name = "rules_steam",
    commit = "1dd525d504350bd74f61456aea92906f7ea4bd45",
    remote = "https://github.com/lanofdoom/rules_steam.git",
)

bazel_dep(name = "auth_by_steam_group")
git_override(
    module_name = "auth_by_steam_group",
    commit = "4305a9f73bc0243e26be28853576e2d8bd59118d",
    remote = "https://github.com/lanofdoom/auth-by-steam-group.git",
)

git_override(
    module_name = "rules_sourcemod",
    commit = "f0573a67a72dbdf366f23233b5d515498aead03c",
    remote = "https://github.com/kleinpa/rules_sourcemod.git",
)

# Cross-compile 32-bit Windows targets (srcds_headless.exe, MetaMod, SourceMod,
# and extensions) from Linux via rules_sourcemod's clang-cl/lld-link + xwin
# toolchain, and build Linux exec tools (spcomp) with rules_sourcemod's hermetic
# Clang toolchain. `accept_license = True` acknowledges Microsoft's Windows SDK
# and MSVC++ Runtime license (https://github.com/Jake-Shadle/xwin#license).
sourcemod = use_extension("@rules_sourcemod//:extensions.bzl", "sourcemod")
sourcemod.windows_cross_toolchain(accept_license = True)
use_repo(sourcemod, "llvm_toolchain_windows_x86_32")

register_toolchains(
    "@rules_sourcemod//linux:all",
    "@llvm_toolchain_windows_x86_32//:cc-toolchain-x86_32-windows",
)

# See //base:bookworm.yaml for the package list.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    name = "bookworm",
    lock = "//base:bookworm.lock.json",
    manifest = "//base:bookworm.yaml",
)
use_repo(apt, "bookworm")

steamapps = use_extension("//:steamapps.bzl", "steamapps_bzlmod")
use_repo(steamapps, "srcds_2006")

# Steamworks SDK Redist, for a current steamclient.dll; app 205's copy predates
# Valve's current Steam CM protocol and cannot connect to Steam servers.
steamapps_steamworks = use_extension("//:steamapps_steamworks.bzl", "steamapps_bzlmod")
use_repo(steamapps_steamworks, "steamworks_sdk_redist")

# Both steamapps*.bzl files are regenerated by .github/workflows/update-steamapps.yml.

#
# File Dependencies
#

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# The Hidden: Source Beta 4b full release. Never distributed through Steam; the
# mod includes a Linux server_i486.so, which is unusable because Valve's Source
# 2006 dedicated server (app 205) ships only for Windows.
http_archive(
    name = "hidden",
    build_file_content = """\
filegroup(
    name = "all",
    srcs = glob(["**/*"], exclude = ["WORKSPACE", "BUILD.bazel"]),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "ae73d35c42a8521dc0c0ebda99e85f3e731176d04abeb7c6263ca4bca0cfe7ae",
    urls = ["http://www.hidden-source.com/downloads/hsb4b-full.zip"],
)

#
# Test Dependencies
#

PYTHON_VERSION = "3.13"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = PYTHON_VERSION,
    requirements_lock = "//tests:requirements.txt",
)
use_repo(pip, "pypi")
