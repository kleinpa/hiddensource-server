+# "x64_windows" here (matching the 64-bit label) is a deliberate label lie
+# to reach that code path; it does not affect codegen, which comes entirely
+# from `target_system_name` (`--target=i686-pc-windows-msvc`) and the
+# `/MACHINE:X86` link/archive flags below. `target_cpu` otherwise only feeds
+# Bazel's own bookkeeping (e.g. the bazel-out directory name).
+def _windows_cpu(target_arch):
+    if target_arch == "x86_32":
+        return "x64_windows"
+    fail("Unsupported Windows target architecture: {}. Only x86_32 (via xwin's 32-bit sysroot) has been wired up in patches/toolchains_llvm-windows-i686.patch.".format(target_arch))
+
+def _machine_arch(target_arch):
+    if target_arch == "x86_32":
+        return "X86"
+    fail("Unsupported Windows target architecture: " + target_arch)
