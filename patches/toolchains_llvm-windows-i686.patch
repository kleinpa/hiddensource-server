+    windows_cc_toolchain_config(
+        name = name,
+        cpu = _windows_cpu(target_arch),
+        # Reported as "msvc-cl", not "clang-cl": rules_cc's `_use_msvc_toolchain`
+        # gate treats them identically, but "msvc-cl" is what makes
+        # `select({"@rules_cc//cc/compiler:msvc-cl": ...})` -- used throughout
+        # this repo's flags (e.g. sourcemod/warnings.bzl, extension/flags.bzl)
+        # to pick MSVC-dialect flags for Windows -- actually match. clang-cl is
+        # a close enough cl.exe emulation that those flags apply unchanged.
+        compiler = "msvc-cl",
+        toolchain_identifier = "clang-cl-{}-windows".format(target_arch),
+        host_system_name = exec_arch,
+        target_system_name = target_system_name,
+        target_libc = "msvc",
+        abi_version = "local",
+        abi_libc_version = "local",
+        cxx_builtin_include_directories = cxx_builtin_include_directories,
+        tool_paths = tool_paths,
+        archiver_flags = ["/MACHINE:" + _machine_arch(target_arch)] + lib_flags,
+        default_link_flags = [
+            "/MACHINE:" + _machine_arch(target_arch),
+        ] + lib_flags,
+        default_compile_flags = [
+            "--target=" + target_system_name,
+            # Real MSVC's /W3, not clang-cl's /Wall: rules_sourcemod's own
+            # warning suppressions (sourcemod/warnings.bzl's
+            # UPSTREAM_WARNING_COPTS, appended after each target's /W3) are
+            # sized against upstream's actual AMBuildScript, which builds
+            # with /W3 and is "already quiet" about everything that list
+            # handles -- see that file's docstring. clang-cl's warning
+            # flags are cumulative, not a strict level override: /Wall here
+            # turns on clang-only diagnostics real MSVC's /W3 never has
+            # (-Wc++98-compat, -Wunsafe-buffer-usage, -Wunused-parameter
+            # among them), and a target's later /W3 doesn't turn them back
+            # off, it just adds its own smaller set on top -- so every
+            # vendored SourceMod/HL2SDK file neither this repo nor upstream
+            # owns warned on all of them, several hundred thousand lines of
+            # it on a clean build. /W3 here matches what upstream's own
+            # warning suppressions actually assume, for both this repo's
+            # targets and rules_sourcemod's.
+            "/W3",
+            "/MT",
+            "/DWIN32",
+            "/D_WIN32",
+            "/D_WINDOWS",
+            "/EHsc",
+            "/std:" + cxx_standard,
+        ] + include_flags,
+        dbg_mode_debug_flag = "/DEBUG /Od",
+        fastbuild_mode_debug_flag = "/DEBUG",
+        supports_parse_showincludes = False,
+        msvc_cl_path = tool_paths["gcc"],
+        msvc_link_path = tool_paths["ld"],
+        msvc_lib_path = tool_paths["ar"],
+        # Not load-bearing for header/lib resolution (the explicit /imsvc and
+        # /libpath: flags above do that) but rules_cc still sets these as
