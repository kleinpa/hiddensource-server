+        fail(("Windows toolchains require a sysroot: a normalized (version-directory-" +
+              "free) Windows SDK + MSVC CRT layout as produced by " +
+              "//windows:xwin_sysroot.bzl. Configure one with " +
+              "`llvm.sysroot(targets = [\"windows-{}\"], ...)`.").format(target_arch))
+    sysroot_path = paths.ensure_trailing_slash(sysroot_path).rstrip("/")
+    arch_dir = _windows_lib_arch_dir(target_arch)
+
+    cxx_standard = compiler_configuration["cxx_standard"]
+
+    # Built as explicit /imsvc (compile) and /libpath: (link) flags rather
+    # than relying on clang-cl's own `/winsysroot:` auto-detection of the
+    # VC-tools/SDK subdirectories: as of LLVM 18, that auto-detection
+    # mis-joins the versioned subdirectory it finds into a malformed path --
+    # observed directly as `-internal-isystem :<root>/VC/Tools/MSVC/include`
+    # (a stray leading `:`), reported as "nonexistent" even though the
+    # directory is right there, silently dropping every sysroot header/lib
+    # path. A *different*, and differently wrong, guess at this same
+    # cross-compile case shipped in the unmerged upstream PR this patch is
+    # otherwise based on (bazel-contrib/toolchains_llvm#642): a single
+    # `/LIBPATH:<root>/lib` that doesn't match any real sysroot layout,
+    # failing with "could not open 'kernel32.lib'". The paths below were
+    # verified against a real xwin-produced sysroot by actually compiling
+    # and linking a small C++ program (STL headers, a virtual call, and
+    # windows.h) end to end -- see the patch's origin PR description for the
+    # exact commands.
