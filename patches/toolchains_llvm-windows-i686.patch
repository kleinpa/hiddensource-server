+        # at the sysroot rather than leaving the "*_not_found" defaults in
+        # the action environment.
+        msvc_env_include = sysroot_path + "/VC/Tools/MSVC/include",
+        msvc_env_lib = sysroot_path + "/VC/Tools/MSVC/lib/" + arch_dir,
+    )
