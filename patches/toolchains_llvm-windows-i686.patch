+# //windows:xwin_sysroot.bzl) for the VC-tools/SDK lib subdirectories.
+def _windows_lib_arch_dir(target_arch):
+    if target_arch == "x86_32":
+        return "x86"
+    fail("Unsupported Windows target architecture: " + target_arch)
