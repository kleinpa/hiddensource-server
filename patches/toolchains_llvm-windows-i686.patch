+        "/imsvc" + sysroot_path + "/WindowsKits/Include/ucrt",
+        "/imsvc" + sysroot_path + "/WindowsKits/Include/um",
+        "/imsvc" + sysroot_path + "/WindowsKits/Include/shared",
+    ]
+    lib_flags = [
+        "/libpath:" + sysroot_path + "/VC/Tools/MSVC/lib/" + arch_dir,
+        "/libpath:" + sysroot_path + "/WindowsKits/Lib/ucrt/" + arch_dir,
+        "/libpath:" + sysroot_path + "/WindowsKits/Lib/um/" + arch_dir,
+    ]
+
+    def _tool(tool_name):
+        return tools_path_prefix + tool_name
+
+    tool_paths = {
+        "ar": _tool("llvm-lib"),
+        "cpp": _tool("clang-cl"),
+        "dwp": _tool("llvm-dwp"),
+        "gcc": _tool("clang-cl"),
+        "gcov": _tool("llvm-profdata"),
+        "ld": _tool("lld-link"),
+        "llvm-cov": _tool("llvm-cov"),
+        "llvm-profdata": _tool("llvm-profdata"),
+        "nm": _tool("llvm-nm"),
+        "objcopy": _tool("llvm-objcopy"),
+        "objdump": _tool("llvm-objdump"),
+        "strip": _tool("llvm-strip"),
+    }
