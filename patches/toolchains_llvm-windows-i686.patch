+# the `target_os == "windows"` dispatch in cc_toolchain_config() above for why
+# this is a separate function rather than a branch woven into the Unix logic.
+def _cc_toolchain_config_windows(
+        name,
+        exec_arch,
+        target_arch,
+        target_system_name,
+        tools_path_prefix,
+        compiler_configuration,
+        cxx_builtin_include_directories):
